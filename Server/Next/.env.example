# Copy this file to .env.local and set the URI for your MongoDB instance.
# Local MongoDB (requires a running MongoDB server on port 27017):
MONGODB_URI=mongodb://127.0.0.1:27017/answers
# For MongoDB Atlas, replace the value with your Atlas connection string.
# Set this only if your local DNS cannot resolve MongoDB Atlas SRV records.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
